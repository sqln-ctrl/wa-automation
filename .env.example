# Neon pooled PostgreSQL connection string. Copy this from Neon Dashboard > Connect.
# Keep the sslmode and channel_binding parameters Neon provides.
DATABASE_URL="postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=

# AI Provider (optional, OpenAI-compatible)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_MODEL=
AI_ENABLED=false

# Auth
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
